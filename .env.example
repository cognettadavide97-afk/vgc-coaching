# Database MySQL. Obbligatoria: l'app non parte senza.
DATABASE_URL=mysql+pymysql://user:password@localhost/vgc_coaching

# Livello minimo dei messaggi di log (INFO/DEBUG/WARNING), letto da
# backend/main.py. Alzalo a DEBUG solo durante un'indagine su un problema:
# in esercizio normale INFO è quello giusto.
LOG_LEVEL=INFO

# Origini autorizzate a chiamare l'API via CORS (separate da virgola).
# In locale il default nel codice copre già 127.0.0.1:8000 e localhost:8000;
# in produzione va impostata con il dominio reale del frontend.
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Invio email transazionali via API Gmail (OAuth2, non SMTP diretto: SMTP è
# bloccato su Railway). Le tre variabili GMAIL_* vengono da un progetto
# Google Cloud con l'API Gmail abilitata + un client OAuth "Desktop app";
# GMAIL_REFRESH_TOKEN si ottiene eseguendo "python scripts/reauth_gmail.py"
# (apre il browser per autorizzare l'app). EMAIL_MITTENTE deve essere lo
# stesso account Gmail autorizzato. Vedi README.md, sezione "Gmail API",
# per la scadenza del token in stato "Testing" e come evitarla.
GMAIL_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=xxxxxxxxxxxxxxxx
EMAIL_MITTENTE=tuoindirizzo@gmail.com
EMAIL_ADMIN=admin@example.com

# Contatti diretti del coach, mostrati nell'email di conferma al cliente.
COACH_DISCORD_TAG=your_discord_tag
COACH_TELEGRAM_CONTACT=t.me/your_telegram

# Webhook Discord: notifica il coach nel suo server a ogni nuova prenotazione.
# Crealo in Discord: Impostazioni canale -> Integrazioni -> Webhook -> Crea Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App OAuth2 Discord per il login opzionale studenti.
# Crea l'app su https://discord.com/developers/applications, sezione OAuth2.
# Il redirect URI configurato li' deve corrispondere esattamente a DISCORD_OAUTH_REDIRECT_URI.
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback

# Login pannello admin (unico account, da variabili d'ambiente).
# ADMIN_PASSWORD_HASH è un hash bcrypt, MAI la password in chiaro — generalo
# con "python scripts/hash_admin_password.py" (chiede la password a
# tastiera, senza mostrarla, e stampa/salva l'hash da mettere qui).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change-me

# Firma dei token JWT del pannello admin.
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Service account Google per la sincronizzazione con Google Calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# Promemoria automatici pre-sessione (opzionali, hanno un default nel codice).
# Quante ore prima della sessione inviare il promemoria.
REMINDER_HOURS_BEFORE=24
# Ogni quanti minuti il job controlla se ci sono promemoria da inviare.
REMINDER_CHECK_INTERVAL_MINUTES=5

# Automazioni aggiunte per recensioni e sincronizzazione calendario
# (opzionali, hanno un default nel codice).
# Dominio pubblico usato per costruire link assoluti nelle email (es. il
# link di recensione post-sessione). Se non impostata, si usa la prima
# origine di FRONTEND_ORIGINS.
PUBLIC_BASE_URL=https://tuo-dominio.up.railway.app
# Ogni quanti minuti il job controlla se ci sono richieste di recensione da inviare.
REVIEW_CHECK_INTERVAL_MINUTES=60
# Ogni quanti minuti il job sincronizza automaticamente gli slot col calendario Google.
CALENDAR_SYNC_INTERVAL_MINUTES=60
# Ogni quante ore il job controlla che GMAIL_REFRESH_TOKEN sia ancora valido,
# avvisando su Discord se smette di funzionare.
GMAIL_HEALTHCHECK_INTERVAL_HOURS=24

# Data retention (vedi backend/services/retention_service.py): dopo quanti
# mesi di inattività (nessuna prenotazione/pacchetto) un cliente viene
# anonimizzato automaticamente. Il job gira una volta al giorno.
RETENTION_MONTHS=24

# Backup automatico del database su Google Drive (vedi
# backend/services/backup_service.py e README.md, sezione "Backup") — il
# piano Railway attuale non include backup/PITR gestiti dalla piattaforma.
# ATTENZIONE: NON usa il service account di GOOGLE_SERVICE_ACCOUNT_EMAIL/
# GOOGLE_PRIVATE_KEY sopra — un service account non ha quota di
# archiviazione propria su Drive (scoperto testando un upload reale, vedi
# il commento in backup_service.py). Usa invece OAuth con l'account Google
# vero del coach, stesso client di GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET (che
# però restano definiti più sopra, non qui). DRIVE_REFRESH_TOKEN si ottiene
# con "python scripts/reauth_drive.py". GOOGLE_DRIVE_BACKUP_FOLDER_ID è
# l'id della cartella Drive di destinazione (una cartella normale del
# coach, non condivisa con nessun service account). BACKUP_RETENTION_DAYS:
# dopo quanti giorni un backup viene eliminato da Drive per non
# accumularsi all'infinito.
DRIVE_REFRESH_TOKEN=your-drive-refresh-token
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your-drive-folder-id
BACKUP_RETENTION_DAYS=30
