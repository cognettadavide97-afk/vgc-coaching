# Database MySQL. Obbligatoria: l'app non parte senza.
DATABASE_URL=mysql+pymysql://user:password@localhost/vgc_coaching

# Chiave segreta generica (non più usata direttamente, ma tenuta per compatibilità).
SECRET_KEY=change-me-to-a-random-secret

# Origini autorizzate a chiamare l'API via CORS (separate da virgola).
# In locale il default nel codice copre già 127.0.0.1:8000 e localhost:8000;
# in produzione va impostata con il dominio reale del frontend.
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Invio email transazionali via SendGrid.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_MITTENTE=noreply@example.com
EMAIL_ADMIN=admin@example.com

# Contatti diretti del coach, mostrati nell'email di conferma al cliente.
COACH_DISCORD_TAG=your_discord_tag
COACH_TELEGRAM_CONTACT=t.me/your_telegram

# Webhook Discord: notifica il coach nel suo server a ogni nuova prenotazione.
# Crealo in Discord: Impostazioni canale -> Integrazioni -> Webhook -> Crea Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App OAuth2 Discord per il login opzionale studenti.
# Crea l'app su https://discord.com/developers/applications, sezione OAuth2.
# Il redirect URI configurato li' deve corrispondere esattamente a DISCORD_OAUTH_REDIRECT_URI.
DISCORD_CLIENT_ID=your_discord_oauth_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback

# Login pannello admin (unico account, da variabili d'ambiente).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Firma dei token JWT del pannello admin.
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Service account Google per la sincronizzazione con Google Calendar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com

# Promemoria automatici pre-sessione (opzionali, hanno un default nel codice).
# Quante ore prima della sessione inviare il promemoria.
REMINDER_HOURS_BEFORE=24
# Ogni quanti minuti il job controlla se ci sono promemoria da inviare.
REMINDER_CHECK_INTERVAL_MINUTES=5
